np.save("LLM MEMORY/w_ff2.npy", w_ff2)
np.save("LLM MEMORY/w_proj.npy", w_proj)
np.save("LLM MEMORY/w_v.npy", w_V)
np.save("LLM MEMORY/w_k.npy", w_K)
np.save("LLM MEMORY/w_q.npy", w_Q)
np.save("LLM MEMORY/b_ff1.npy", b_ff1)
np.save("LLM MEMORY/b_ff2.npy", b_ff2)
np.save("LLM MEMORY/b_lm.npy", b_lm)
